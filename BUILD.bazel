load("//build/kernel/kleaf:kernel.bzl", "kernel_dtstree")

kernel_dtstree(
    name = "msm_dt",
    srcs = glob(
        [
            "Makefile",
            "qcom/**/*.dtsi",
            "qcom/**/*.h",
            "qcom/**/*.dts",
            "qcom/**/*.dtso",
            "qcom/**/Makefile",
            "oplus/Makefile",
            "oplus/**/*.dtsi",
            "oplus/**/*.dts",
            "oplus/**/*.dtso",
            "bindings/**/*",
        ],
        exclude = [
            "**/.*",
            "**/.*/**",
            "**/*.bazel",
            "**/*.bzl",
        ],
    ) + [
        "//common:kernel_aarch64_sources",
        "//vendor/qcom/sm8850-modules/qcom/opensource/audio-kernel:inline_dt_bindings",
        "//vendor/qcom/sm8850-modules/qcom/opensource/camera-kernel:inline_dt_bindings",
        "//vendor/qcom/sm8850-modules/qcom/opensource/synx-kernel:inline_dt_bindings",
    ],
    visibility = ["//visibility:public"],
)
